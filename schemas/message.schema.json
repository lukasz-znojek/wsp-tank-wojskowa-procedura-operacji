{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lukasz-znojek.github.io/wsp-tank-wojskowa-procedura-operacji/schemas/message.schema.json",
  "title": "Komunikat (scenariusz symulacyjny)",
  "description": "Kontrakt danych komunikatu wymienianego w fikcyjnym scenariuszu szkoleniowym. Wyłącznie dane syntetyczne.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
    "synthetic": { "const": true },
    "status": {
      "type": "string",
      "enum": ["szkic", "do-przegladu", "zatwierdzony", "opublikowany", "odrzucony"]
    },
    "sender_role": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
    "recipient_role": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
    "sent_at_label": { "type": "string", "pattern": "^T\\+[0-9]{2}:[0-9]{2}$" },
    "channel": { "type": "string", "enum": ["symulowany-tekstowy", "symulowany-glosowy", "notatka-wewnetrzna"] },
    "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "body": { "type": "string", "minLength": 1 },
    "confidence": { "type": "string", "enum": ["potwierdzone", "prawdopodobne", "niepotwierdzone"] },
    "acknowledged": { "type": "boolean" },
    "related_artifacts": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9-]+$" } }
  },
  "required": ["id", "synthetic", "status", "sender_role", "recipient_role", "subject", "body"]
}
